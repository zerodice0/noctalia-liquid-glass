diff --git i/umbrielfx/render/fx_renderer/shaders/tex.frag w/umbrielfx/render/fx_renderer/shaders/tex.frag
index 7ef99d5..7fb0d5b 100644
--- i/umbrielfx/render/fx_renderer/shaders/tex.frag
+++ w/umbrielfx/render/fx_renderer/shaders/tex.frag
@@ -59,6 +59,83 @@ uniform float clip_radius_bottom_right;
 
 uniform float discard_transparent;
 
+// Backdrop-only optical pass. Distances are physical framebuffer pixels, like
+// the existing blur radius. A zero strength takes the original texture path.
+uniform vec4 glass_params; // strength, edge width, RGB dispersion, edge light
+uniform vec4 glass_box;
+uniform vec4 glass_radii;
+uniform vec2 glass_texel;
+uniform sampler2D glass_mask;
+uniform mat3 glass_mask_proj;
+uniform float glass_mask_threshold;
+
+float glass_inside(vec2 pixel) {
+	vec2 local = (pixel - glass_box.xy) / max(glass_box.zw, vec2(1.0));
+	if (local.x < 0.0 || local.y < 0.0 || local.x > 1.0 || local.y > 1.0) return 0.0;
+	vec2 uv = (vec3(local, 1.0) * glass_mask_proj).xy;
+	return step(glass_mask_threshold, texture2D(glass_mask, uv).a);
+}
+
+// Locate the visible card edge rather than its layer-shell allocation (which
+// includes transparent padding for dock magnification and panel shadows).
+// Interior pixels need just four mask reads. Search only rays crossing an edge.
+float glass_edge_distance(vec2 pixel, vec2 direction, float width) {
+	if (glass_inside(pixel + direction * width) > 0.5) return width;
+	float low = 0.0;
+	float high = width;
+	for (int i = 0; i < 6; ++i) {
+		float middle = (low + high) * 0.5;
+		if (glass_inside(pixel + direction * middle) > 0.5) low = middle;
+		else high = middle;
+	}
+	return (low + high) * 0.5;
+}
+
+vec4 glass_sample() {
+	vec2 p = gl_FragCoord.xy;
+	vec2 half_size = max(glass_box.zw * 0.5, vec2(1.0));
+	vec2 center = p - glass_box.xy - half_size;
+	float radius = center.x < 0.0
+		? (center.y < 0.0 ? glass_radii.x : glass_radii.z)
+		: (center.y < 0.0 ? glass_radii.y : glass_radii.w);
+	radius = clamp(radius, 0.0, min(half_size.x, half_size.y));
+	vec2 q = abs(center) - half_size + radius;
+	float distance = -(min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - radius);
+	vec2 normal;
+	if (max(q.x, q.y) > 0.0) normal = normalize(max(q, 0.0) + vec2(0.00001)) * sign(center);
+	else normal = q.x > q.y ? vec2(sign(center.x), 0.0) : vec2(0.0, sign(center.y));
+	float width = min(glass_params.y, min(half_size.x, half_size.y));
+	if (glass_mask_threshold > 0.0) {
+		float left = glass_edge_distance(p, vec2(-1.0, 0.0), width);
+		float right = glass_edge_distance(p, vec2(1.0, 0.0), width);
+		float top = glass_edge_distance(p, vec2(0.0, -1.0), width);
+		float bottom = glass_edge_distance(p, vec2(0.0, 1.0), width);
+		vec4 weight = vec4(1.0) - vec4(left, right, top, bottom) / width;
+		weight *= weight;
+		vec2 gradient = vec2(weight.y - weight.x, weight.w - weight.z);
+		normal = gradient / max(length(gradient), 0.0001);
+		distance = min(min(left, right), min(top, bottom));
+	}
+	float edge = 1.0 - smoothstep(0.0, width, max(distance, 0.0));
+	// Snell refraction through a rounded rim, with a bounded sampling footprint.
+	vec3 surface_normal = normalize(vec3(normal * edge * 0.98, sqrt(max(0.001, 1.0 - edge * edge))));
+	vec3 ray = refract(vec3(0.0, 0.0, -1.0), surface_normal, 1.0 / 1.45);
+	vec2 displacement = ray.xy / max(-ray.z, 0.1);
+	displacement /= max(1.0, length(displacement));
+	vec2 offset = displacement * glass_params.x * glass_texel;
+	vec2 lo = glass_texel * 0.5;
+	vec2 hi = vec2(1.0) - lo;
+	vec4 color = texture2D(tex, clamp(v_texcoord + offset, lo, hi));
+	if (glass_params.z > 0.0 && edge > 0.0) {
+		color.r = texture2D(tex, clamp(v_texcoord + offset * (1.0 + glass_params.z), lo, hi)).r;
+		color.b = texture2D(tex, clamp(v_texcoord + offset * (1.0 - glass_params.z), lo, hi)).b;
+	}
+	float light = 0.35 + 0.65 * max(dot(normal, normalize(vec2(-0.6, -0.8))), 0.0);
+	float rim = exp(-max(distance, 0.0) / 1.6);
+	color.rgb = mix(color.rgb, vec3(color.a), glass_params.w * light * (0.22 * edge + 0.78 * rim));
+	return color;
+}
