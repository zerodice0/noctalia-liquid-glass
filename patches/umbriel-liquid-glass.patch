+		// Radial search follows diagonal corners and nested alpha contours.
+		// Interior fragments only do the coarse probes; expensive boundary
+		// refinement is confined to the rim. Ignore opaque foreground pixels.
+		bool near_edge = false;
+		for (int i = 0; i < 8; ++i) {
+			float angle = float(i) * 0.7853981634;
+			vec2 direction = vec2(cos(angle), sin(angle));
+			if (glass_alpha(p + direction * width) < threshold) near_edge = true;
+		}
+		if (!near_edge) return texture2D(tex, v_texcoord);
+		vec2 gradient = vec2(0.0);
+		distance = width;
+		for (int i = 0; i < 16; ++i) {
+			float angle = float(i) * 0.3926990817;
+			vec2 direction = vec2(cos(angle), sin(angle));
+			float ray_distance = glass_edge_distance(p, direction, width, threshold);
+			float weight = max(0.0, 1.0 - ray_distance / width);
+			gradient += direction * weight * weight * weight;
+			distance = min(distance, ray_distance);
+		}
+		normal = gradient / max(length(gradient), 0.0001);
+	}
